rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    // Size and type limits mirror src/lib/media-policy.ts.
    function isAllowedMedia() {
      let type = request.resource.contentType;
      let size = request.resource.size;
      return size > 0 && ((type.matches('image/(png|jpeg|webp|avif|gif)') && size <= 10 * 1024 * 1024)
        || (type.matches('video/(mp4|webm)') && size <= 60 * 1024 * 1024)
        || (type == 'application/pdf' && size <= 15 * 1024 * 1024));
    }

    match /portfolio/{folder}/{allPaths=**} {
      // Public portfolio media only. Sensitive/operator files belong outside this bucket path.
      function publicFolder() { return folder in ['projects', 'about', 'cv', 'hero', 'profile']; }
      allow get: if publicFolder();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && publicFolder() && isAllowedMedia();
      allow delete: if isAdmin();
    }
    match /portfolio/{allPaths=**} { allow list: if isAdmin(); }
  }
}
