# Values here are placeholders. Never place server credentials under NEXT_PUBLIC_.
# Prefer npm run dev:emulator for isolated local work; its wrapper overrides all Firebase targets.
GEMINI_API_KEY=your-server-only-gemini-key
GEMINI_MODEL=your-primary-gemini-model
GEMINI_MODEL_FALLBACK=your-fallback-gemini-model

NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:placeholder
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-PLACEHOLDER

# Set explicitly per Vercel target if system environment exposure is disabled.
NEXT_PUBLIC_VERCEL_ENV=development
# Default 0: supported admin/contact writes are blocked in Preview.
# Set 1 ONLY for a separate non-production Firebase project.
NEXT_PUBLIC_ALLOW_PREVIEW_WRITES=0
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=0
# Used only when USE_EMULATORS=1 (wrapper supplies all matching demo settings).
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
