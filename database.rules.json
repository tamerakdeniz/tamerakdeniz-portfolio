{
  "rules": {
    "siteData": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true",
      "projects": {
        "$id": {
          ".validate": "newData.child('published').val() === true"
        }
      },
      "skills": {
        "$id": {
          ".validate": "newData.child('published').val() !== false"
        }
      },
      "timeline": {
        "$id": {
          ".validate": "newData.child('published').val() !== false"
        }
      }
    },
    "siteDrafts": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true"
    },
    "contactSubmissions": {
      ".read": "auth != null && auth.token.admin === true",
      "$id": {
        ".write": "auth != null && (auth.token.admin === true || (auth.uid === 'portfolio-intake-server' && !data.exists() && newData.exists() && newData.child('createdAt').val() === now && newData.child('read').val() === false && newData.child('id').val() === $id))",
        ".validate": "newData.hasChildren(['name', 'email', 'subject', 'message', 'timestamp'])",
        "id": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().matches(/^[^ @]+@[^ @]+\\.[^ @]+$/)"
        },
        "subject": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 5000"
        },
        "timestamp": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "read": {
          ".validate": "newData.isBoolean()"
        },
        "important": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "contactMeta": {
      ".read": false,
      ".write": false
    },
    "adminPasswordHash": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true"
    },
    "activityLog": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true"
    },
    "$other": {
      ".read": false,
      ".write": false
    },
    "_serverLimits": {
      ".read": "auth != null && auth.uid === 'portfolio-intake-server'",
      ".write": "auth != null && auth.uid === 'portfolio-intake-server'"
    }
  }
}
