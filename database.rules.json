{
  "rules": {
    "siteData": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true",
      "projects": {
        "$id": {
          ".validate": "newData.child('published').val() !== false"
        }
      },
      "skills": {
        "$id": {
          ".validate": "newData.child('published').val() !== false"
        }
      },
      "timeline": {
        "$id": {
          ".validate": "newData.child('published').val() !== false"
        }
      }
    },
    "siteDrafts": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true"
    },
    "contactSubmissions": {
      ".read": "auth != null && auth.token.admin === true",
      "$id": {
        ".write": "(auth != null && auth.token.admin === true) || (!data.exists() && newData.exists() && $id.matches(/^[0-9]{13}(-[a-z0-9]{4,12})?$/) && newData.child('id').val() === $id && newData.child('read').val() === false && newData.child('createdAt').val() === now && newData.parent().parent().child('contactMeta/lastAt').val() === now && newData.parent().parent().child('contactMeta/lastId').val() === $id)",
        ".validate": "newData.hasChildren(['name', 'email', 'subject', 'message', 'timestamp'])",
        "id": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().matches(/^[^ @]+@[^ @]+\\.[^ @]+$/)"
        },
        "subject": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 5000"
        },
        "timestamp": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "read": {
          ".validate": "newData.isBoolean()"
        },
        "important": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "contactMeta": {
      ".write": "newData.hasChildren(['lastAt', 'lastId']) && newData.child('lastAt').val() === now && (!data.child('lastAt').exists() || now - data.child('lastAt').val() >= 20000) && newData.child('lastId').isString() && !root.child('contactSubmissions').child(newData.child('lastId').val()).exists() && newData.parent().child('contactSubmissions').child(newData.child('lastId').val()).child('createdAt').val() === now",
      "lastAt": {
        ".validate": "newData.isNumber()"
      },
      "lastId": {
        ".validate": "newData.isString() && newData.val().matches(/^[0-9]{13}(-[a-z0-9]{4,12})?$/)"
      },
      "$other": {
        ".validate": false
      }
    },
    "adminPasswordHash": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true"
    },
    "activityLog": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true"
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
